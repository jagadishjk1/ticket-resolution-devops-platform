# Remote state in S3 with native locking (Terraform >= 1.10).
# 1. cd ../terraform/bootstrap-state && terraform init && terraform apply
# 2. Copy this file to backend.tf, replace the bucket name with the output value
# 3. terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "REPLACE-WITH-STATE-BUCKET"
    key          = "ticket-swarm/dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
